# Copy this file to .env and fill in real values. NEVER commit .env.
# Placeholders only below.

# Which settings module to load (dev or prod).
DJANGO_SETTINGS_MODULE=config.settings.dev

# Required. Generate a long random string, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret

# Production only.
DJANGO_ALLOWED_HOSTS = "*"

# Path-prefix proxy support. Set this ONLY when the app is reached through a
# proxy that strips a sub-path and sends no X-Forwarded-Prefix header — e.g.
# code-server's /proxy/<port>/ . Then every link/redirect/asset URL is prefixed
# so navigation stays inside the mount. Leave empty for direct access or a
# code-server /absproxy/<port>/ mount (auto-detected). Example:
#   APP_URL_PREFIX=/proxy/8899
APP_URL_PREFIX=


